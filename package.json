{
  "name": "lucid-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:ui": "vite",
    "tls-inspector": "node --experimental-strip-types tools/tls-inspector.ts",
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.workers.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5",
    "tldts": "^7.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "~4.1.12",
    "wrangler": "^4.164.0"
  }
}
